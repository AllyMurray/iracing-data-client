{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "npm",
    "github-actions"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": [
    "* 0-5 * * *"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "separateMajorMinor": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "security"
    ],
    "schedule": [],
    "prConcurrentLimit": 0,
    "prCreation": "immediate",
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Automatically merge minor and patch updates after required CI passes.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Prioritize transitive refreshes over ordinary version bumps.",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "prPriority": 10
    },
    {
      "description": "Match pnpm's 24-hour delay and reject releases with missing timestamps.",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Owned toolkit releases skip the delay but still require successful CI.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@http-client-toolkit/*"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Keep the TS6 compiler API on its compatible major version.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@typescript/typescript6"
      ],
      "allowedVersions": ">=6.0.0 <7.0.0"
    },
    {
      "description": "Review native compiler patches together with scripts/check-toolchain.mjs; broader TS upgrades need declaration-generator review.",
      "matchManagers": [
        "npm"
      ],
      "matchDepNames": [
        "@typescript/native"
      ],
      "allowedVersions": ">=7.0.0 <7.1.0"
    },
    {
      "description": "Keep Node types on the Node 24 development line without changing consumer support.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": ">=24.0.0 <25.0.0"
    },
    {
      "description": "Separate stable size-tool patches from minor updates, matching comic-vine.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "size-limit",
        "@size-limit/file"
      ],
      "matchCurrentVersion": ">=1.0.0",
      "separateMinorPatch": true
    },
    {
      "description": "Wait three days before merging stable size-tool patches.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "size-limit",
        "@size-limit/file"
      ],
      "matchCurrentVersion": ">=1.0.0",
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "development tooling patches",
      "minimumReleaseAge": "3 days",
      "constraintsFiltering": "strict"
    },
    {
      "description": "Preserve runtime constraints for consumer-facing and documentation dependencies.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies"
      ],
      "constraintsFiltering": "strict"
    },
    {
      "description": "Node support is a deliberate compatibility decision: preserve engines.node >=22.0.0.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "description": "Preserve existing consumer support when proposing peer range extensions.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "peerDependencies"
      ],
      "rangeStrategy": "widen",
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Keep the Node 22/24 test matrix and Node 24 tooling runtime deliberate; update action versions separately.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "node"
      ],
      "enabled": false
    },
    {
      "description": "Keep unrelated pre-1.0 packages separate so CI checks each upgrade independently.",
      "matchManagers": [
        "npm"
      ],
      "matchCurrentVersion": "<1.0.0",
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Unrelated major upgrades stay separate and require review.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "groupSlug": null,
      "automerge": false
    },
    {
      "description": "Group owned HTTP toolkit updates within the current major when additional toolkit packages are added.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@http-client-toolkit/*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "http client toolkit",
      "groupSlug": "http-client-toolkit"
    },
    {
      "description": "Group GitHub Actions updates, keeping majors separate from minor and patch updates.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": true,
      "separateMinorPatch": false
    },
    {
      "description": "Both manifests must use the same pinned pnpm release.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "packageManager"
      ],
      "matchPackageNames": [
        "pnpm"
      ],
      "groupName": "pnpm",
      "groupSlug": "pnpm"
    },
    {
      "description": "Keep Vite+ and its aliased core at the same release. Vitest is owned by Vite+ and updates through its exact transitive dependency; CI rejects mismatches.",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "pnpm-workspace.yaml"
      ],
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core"
      ],
      "groupName": "vite plus toolchain",
      "groupSlug": "vite-plus-toolchain",
      "separateMajorMinor": true,
      "separateMinorPatch": false,
      "rangeStrategy": "pin"
    },
    {
      "description": "Keep size-limit and its exact-version peer plugin together, including coordinated major upgrades. Majors remain manual.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "size-limit",
        "@size-limit/file"
      ],
      "groupName": "size limit",
      "groupSlug": "size-limit"
    },
    {
      "description": "Group TypeScript and execution-tool patches/minors; preserve compiler compatibility bounds.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "typescript",
        "@typescript/typescript6",
        "tsx"
      ],
      "groupName": "typescript and build tooling"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "@types/**"
      ],
      "groupName": "type definitions"
    }
  ],
  "separateMinorPatch": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-5 * * *"
    ],
    "automerge": false
  }
}
