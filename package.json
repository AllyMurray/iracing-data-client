{
  "name": "iracing-data-client",
  "version": "0.4.0",
  "description": "Fully-typed HTTP Client for the iRacing Data API with automatic code generation, opt-in caching, smart authentication, and comprehensive error handling.",
  "homepage": "https://allymurray.github.io/iracing-data-client/",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "sdk:generate": "npx tsx scripts/generate-sdk.ts",
    "sdk:check-no-unknown": "npx tsx scripts/check-no-unknown-service-returns.ts",
    "sdk:test": "npx @dotenvx/dotenvx run -- npx tsx test-sdk.ts",
    "samples:scrape": "npx @dotenvx/dotenvx run -- npx tsx scripts/scrape-api-samples.ts",
    "samples:scrape-force": "npx @dotenvx/dotenvx run -- npx tsx scripts/scrape-api-samples.ts docs/api/index.json samples --force",
    "samples:scrape-missing": "npx @dotenvx/dotenvx run -- npx tsx scripts/scrape-api-samples.ts docs/api/index.json samples --force --missing-only",
    "probe:season-team-standings": "npx @dotenvx/dotenvx run -- npx tsx scripts/probe-season-team-standings.ts",
    "docs:dev": "cd docs-site && pnpm dev",
    "docs:build": "cd docs-site && pnpm build",
    "docs:preview": "cd docs-site && pnpm preview",
    "test": "vitest",
    "test:package": "pnpm run build && pnpm run test:package:artifacts",
    "test:integration": "npx @dotenvx/dotenvx run -- vitest run --config vitest.config.integration.ts",
    "test:oauth": "npx @dotenvx/dotenvx run -- npx tsx test-oauth.ts",
    "typecheck": "tsc --noEmit",
    "test:package:artifacts": "node build-tests/check-package.cjs",
    "test:dependency-policy": "node build-tests/dependency-policy.cjs"
  },
  "keywords": [
    "iracing",
    "iracing-api",
    "iracing-data-api",
    "iracing-data-client",
    "sim-racing",
    "motorsport",
    "racing",
    "typescript",
    "api-client",
    "sdk",
    "oauth2",
    "esports"
  ],
  "author": "Ally Murray",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllyMurray/iracing-data-client"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@dotenvx/dotenvx": "^1.55.1",
    "@types/node": "^24.3.1",
    "json-schema-to-zod": "^2.6.1",
    "quicktype-core": "^23.2.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@http-client-toolkit/core": "^4.2.0",
    "zod": "4.1.5"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  }
}
