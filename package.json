{
  "name": "iracing-data-client",
  "version": "0.5.5",
  "description": "Fully-typed HTTP Client for the iRacing Data API with automatic code generation, opt-in caching, smart authentication, and comprehensive error handling.",
  "homepage": "https://allymurray.github.io/iracing-data-client/",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "bun run check:toolchain && tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "bun run build",
    "sdk:generate": "tsx scripts/generate-sdk.ts",
    "sdk:check-no-unknown": "tsx scripts/check-no-unknown-service-returns.ts",
    "sdk:test": "dotenvx run -- tsx test-sdk.ts",
    "samples:scrape": "dotenvx run -- tsx scripts/scrape-api-samples.ts",
    "samples:scrape-force": "dotenvx run -- tsx scripts/scrape-api-samples.ts docs/api/index.json samples --force",
    "samples:scrape-missing": "dotenvx run -- tsx scripts/scrape-api-samples.ts docs/api/index.json samples --force --missing-only",
    "probe:season-team-standings": "dotenvx run -- tsx scripts/probe-season-team-standings.ts",
    "credentials:keepalive": "dotenvx run -- tsx scripts/keepalive-oauth-clients.ts",
    "docs:dev": "cd docs-site && bun run dev",
    "docs:build": "cd docs-site && bun run build",
    "docs:preview": "cd docs-site && bun run preview",
    "test": "bun test --path-ignore-patterns=\"**/*.integration.test.ts\"",
    "test:package": "bun run build && bun run test:build:size && bun run test:package:artifacts",
    "test:integration": "dotenvx run -- bun test .integration.test.ts",
    "test:oauth": "dotenvx run -- tsx test-oauth.ts",
    "typecheck": "bun check --no-script",
    "test:package:artifacts": "node build-tests/check-package.cjs",
    "test:dependency-policy": "node build-tests/dependency-policy.cjs",
    "test:env": "node build-tests/check-env.cjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check": "bun run format:check && bun run lint",
    "lint": "bun lint --no-script --type-aware --type-check src scripts build-tests tsdown.config.ts",
    "format": "bun fmt src scripts build-tests tsdown.config.ts",
    "test:release": "node --test build-tests/release.test.mjs build-tests/runtime-release.test.mjs",
    "prepare": "husky",
    "pre-commit": "bun run check && bun run test",
    "test:build:size": "size-limit",
    "test:audit-policy": "node --test build-tests/audit-dependencies.test.mjs",
    "format:check": "bun fmt --check src scripts build-tests tsdown.config.ts",
    "check:bun-version": "node scripts/check-bun-version.mjs",
    "test:bun-version": "node --test build-tests/bun-version.test.mjs"
  },
  "keywords": [
    "iracing",
    "iracing-api",
    "iracing-data-api",
    "iracing-data-client",
    "sim-racing",
    "motorsport",
    "racing",
    "typescript",
    "api-client",
    "sdk",
    "oauth2",
    "esports"
  ],
  "author": "Ally Murray",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllyMurray/iracing-data-client"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@dotenvx/dotenvx": "^2.38.2",
    "@size-limit/file": "^14.3.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "husky": "9.1.7",
    "size-limit": "^14.3.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.6",
    "tsdown": "0.23.7",
    "@types/bun": "1.4.4"
  },
  "dependencies": {
    "@http-client-toolkit/core": "5.0.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "size-limit": [
    {
      "name": "ESM (raw)",
      "path": "lib/index.mjs",
      "brotli": false,
      "limit": "185 kB"
    },
    {
      "name": "CommonJS (raw)",
      "path": "lib/index.js",
      "brotli": false,
      "limit": "225 kB"
    },
    {
      "name": "ESM (gzip)",
      "path": "lib/index.mjs",
      "gzip": true,
      "limit": "28 kB"
    },
    {
      "name": "CommonJS (gzip)",
      "path": "lib/index.js",
      "gzip": true,
      "limit": "30 kB"
    }
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "patchedDependencies": {
    "size-limit@14.3.0": "patches/size-limit@14.3.0.patch"
  },
  "overrides": {
    "tsdown": {
      "rolldown-plugin-dts": "0.28.8"
    }
  }
}
