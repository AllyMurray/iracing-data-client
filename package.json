{
  "name": "iracing-data-client",
  "version": "0.5.3",
  "description": "Fully-typed HTTP Client for the iRacing Data API with automatic code generation, opt-in caching, smart authentication, and comprehensive error handling.",
  "homepage": "https://allymurray.github.io/iracing-data-client/",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm run check:toolchain && vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "pnpm run build",
    "sdk:generate": "tsx scripts/generate-sdk.ts",
    "sdk:check-no-unknown": "tsx scripts/check-no-unknown-service-returns.ts",
    "sdk:test": "dotenvx run -- tsx test-sdk.ts",
    "samples:scrape": "dotenvx run -- tsx scripts/scrape-api-samples.ts",
    "samples:scrape-force": "dotenvx run -- tsx scripts/scrape-api-samples.ts docs/api/index.json samples --force",
    "samples:scrape-missing": "dotenvx run -- tsx scripts/scrape-api-samples.ts docs/api/index.json samples --force --missing-only",
    "probe:season-team-standings": "dotenvx run -- tsx scripts/probe-season-team-standings.ts",
    "credentials:keepalive": "dotenvx run -- tsx scripts/keepalive-oauth-clients.ts",
    "docs:dev": "cd docs-site && pnpm dev",
    "docs:build": "cd docs-site && pnpm build",
    "docs:preview": "cd docs-site && pnpm preview",
    "test": "vp test",
    "test:package": "pnpm run build && pnpm run test:build:size && pnpm run test:package:artifacts",
    "test:integration": "dotenvx run -- vp test run --config vite.config.integration.mts",
    "test:oauth": "dotenvx run -- tsx test-oauth.ts",
    "typecheck": "tsc --noEmit",
    "test:package:artifacts": "node build-tests/check-package.cjs",
    "test:dependency-policy": "node build-tests/dependency-policy.cjs",
    "test:env": "node build-tests/check-env.cjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check": "vp check src scripts build-tests vite.config.mts vite.config.integration.mts",
    "lint": "vp check --no-fmt src scripts build-tests vite.config.mts vite.config.integration.mts",
    "format": "vp fmt src scripts build-tests vite.config.mts vite.config.integration.mts",
    "test:release": "node --test build-tests/release.test.mjs build-tests/runtime-release.test.mjs",
    "prepare": "husky",
    "pre-commit": "pnpm run check && pnpm test run",
    "test:build:size": "size-limit",
    "test:audit-policy": "node --test build-tests/audit-dependencies.test.mjs"
  },
  "keywords": [
    "iracing",
    "iracing-api",
    "iracing-data-api",
    "iracing-data-client",
    "sim-racing",
    "motorsport",
    "racing",
    "typescript",
    "api-client",
    "sdk",
    "oauth2",
    "esports"
  ],
  "author": "Ally Murray",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/AllyMurray/iracing-data-client"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@dotenvx/dotenvx": "^2.34.2",
    "@size-limit/file": "^14.2.0",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "husky": "9.1.7",
    "size-limit": "^14.2.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "@http-client-toolkit/core": "4.2.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "size-limit": [
    {
      "name": "ESM (raw)",
      "path": "lib/index.mjs",
      "brotli": false,
      "limit": "185 kB"
    },
    {
      "name": "CommonJS (raw)",
      "path": "lib/index.js",
      "brotli": false,
      "limit": "225 kB"
    },
    {
      "name": "ESM (gzip)",
      "path": "lib/index.mjs",
      "gzip": true,
      "limit": "28 kB"
    },
    {
      "name": "CommonJS (gzip)",
      "path": "lib/index.js",
      "gzip": true,
      "limit": "30 kB"
    }
  ]
}
