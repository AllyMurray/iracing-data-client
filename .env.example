# iRacing OAuth Credentials
# Get these from iRacing after registering your OAuth client
IRACING_CLIENT_ID=your-client-id
IRACING_CLIENT_SECRET=your-client-secret

# Your iRacing account (must match registered client owner)
IRACING_USERNAME=your-email@example.com
IRACING_PASSWORD=your-password

# Optional: OAuth client pairs used by the weekly credential keepalive workflow.
# Omit enabled or set it to true to enable a pair. Set enabled to false to skip it.
IRACING_KEEPALIVE_CLIENTS='[{"name":"project-a","clientId":"your-client-id","clientSecret":"your-client-secret","enabled":true},{"name":"project-b","clientId":"another-client-id","clientSecret":"another-client-secret","enabled":false}]'
